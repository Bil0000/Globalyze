{
  "name": "globalyze",
  "version": "0.1.0",
  "description": "A Bun-powered CLI that internationalizes React and Next.js applications automatically.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bil0000/Globalyze.git"
  },
  "type": "module",
  "packageManager": "bun@1.2.20",
  "bin": {
    "globalyze": "./bin/globalyze"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "globalyze": "bun run ./src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "bun run lint && bun test"
  },
  "engines": {
    "bun": ">=1.2.20"
  },
  "dependencies": {
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@clack/prompts": "^1.1.0",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "commander": "^14.0.1",
    "diff": "^8.0.3",
    "dotenv": "^17.2.3",
    "fast-glob": "^3.3.3",
    "fast-levenshtein": "^3.0.0",
    "fs-extra": "^11.3.2",
    "lingo.dev": "latest",
    "log-symbols": "^7.0.1",
    "openai": "^5.20.2",
    "ora": "^9.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/fs-extra": "^11.0.4",
    "bun-types": "^1.2.20",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
